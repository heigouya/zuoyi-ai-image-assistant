{
  "name": "zuoyi-ai-image-assistant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "local": "node bridge/start-local.mjs",
    "local:test-codex": "node bridge/start-smoke-test.mjs",
    "bridge": "node bridge/codex-job-server.mjs",
    "workbench:sample": "node bridge/submit-job.mjs bridge/sample-amazon-job.json",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/local-bridge.test.mjs",
    "check": "node --check bridge/codex-job-server.mjs && node --check bridge/start-local.mjs && node --check bridge/start-smoke-test.mjs && node --check bridge/submit-job.mjs",
    "test:site": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
